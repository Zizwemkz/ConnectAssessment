{
  "openapi": "3.0.4",
  "info": {
    "title": "ConnectAssessment",
    "version": "1.0"
  },
  "paths": {
    "/api/Customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/tbCustomer"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/tbCustomer"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/tbCustomer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/CustomerSettlement/settle": {
      "post": {
        "tags": [
          "CustomerSettlement"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettleCustomerRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SettleCustomerRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SettleCustomerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SettleCustomerResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettleCustomerResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettleCustomerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Palindrome/Palindrome": {
      "post": {
        "tags": [
          "Palindrome"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PalindromeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PalindromeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PalindromeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PalindromeResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PalindromeResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PalindromeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PalindromeRequest": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PalindromeResponse": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "nullable": true
          },
          "isPalindrome": {
            "type": "boolean"
          },
          "normalized": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SettleCustomerRequest": {
        "required": [
          "amount",
          "customerId"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "maximum": 200000,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SettleCustomerResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "transactionFee": {
            "type": "number",
            "format": "double"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "tbCustomer": {
        "required": [
          "accountNumber",
          "companyName",
          "name",
          "surName"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "surName": {
            "minLength": 1,
            "type": "string"
          },
          "companyName": {
            "minLength": 1,
            "type": "string"
          },
          "accountNumber": {
            "minLength": 1,
            "type": "string"
          },
          "branch": {
            "type": "string",
            "nullable": true
          },
          "settlementTransactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/tbSettlementTransaction"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "tbSettlementTransaction": {
        "required": [
          "amount",
          "customerId",
          "date",
          "success",
          "transactionFee"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "transactionFee": {
            "type": "number",
            "format": "double"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "success": {
            "type": "boolean"
          },
          "customer": {
            "$ref": "#/components/schemas/tbCustomer"
          }
        },
        "additionalProperties": false
      }
    }
  }
}